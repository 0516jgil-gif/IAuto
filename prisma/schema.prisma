datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Cliente {
  id               Int        @id @default(autoincrement())
  nombre           String
  email            String     @unique
  telefono         String?
  password         String
  verificationCode String?
  ventas           Venta[]
  favoritos        Favorito[]
}

model Empleado {
  id               Int     @id @default(autoincrement())
  nombre           String
  email            String  @unique
  rol              String  @default("trabajador")
  password         String?
  verificationCode String?
  ventas           Venta[]
}

model Vehiculo {
  id          Int      @id @default(autoincrement())
  marca       String
  modelo      String
  precio      Float
  stock       Int
  imagenes    String[]
  anio        Int?
  combustible String?
  potencia    Int?
  transmision String?
  carroceria  String?
  color       String?
  kilometros  Int?
  puertas     Int?
  plazas      Int?
  descripcion String?
  ventas      Venta[]
  favoritos   Favorito[]
}

model Venta {
  id    Int      @id @default(autoincrement())
  fecha DateTime @default(now())

  clienteId  Int
  empleadoId Int
  vehiculoId Int

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  empleado Empleado @relation(fields: [empleadoId], references: [id])
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  cantidad Int
  total    Float
  estado   String @default("pendiente")
}

model Favorito {
  id    Int      @id @default(autoincrement())
  fecha DateTime @default(now())

  clienteId  Int
  vehiculoId Int

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, vehiculoId])
}
